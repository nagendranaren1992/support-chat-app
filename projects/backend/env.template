# Database Configuration
# PostgreSQL connection settings
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=your_database_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# Google Cloud Storage Configuration
# Option 1: For local development - Path to your GCP service account key file
GCP_KEYFILE_PATH=path/to/your/gcp-keyfile.json
# Option 2: For production (Render, etc.) - GCP credentials as JSON string
# Copy the entire contents of your JSON key file as a single-line string
# GCP_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
# Your GCS bucket name
GCP_BUCKET_NAME=your-bucket-name

# OpenAI Configuration
# Your OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
# Port for the backend server (optional, defaults to 3000)
PORT=3000

